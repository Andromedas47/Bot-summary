# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to the browser. Used by the webhook handler.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── LINE Messaging API ───────────────────────────────────────────────────────
# Found in: LINE Developers console → your channel → Basic settings
LINE_CHANNEL_SECRET=your-channel-secret-here

# Optional: needed only if you send reply/push messages
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token-here

# Comma/space-separated LINE group IDs allowed to use P2A Physical Inventory.
# Set to an empty value to disable Physical Inventory routing.
PHYSICAL_INVENTORY_LINE_GROUP_IDS=C1d96954d298d99f65912a5f1e96edffc

# OpenAI vision extraction for Phase 2 slip checks
OPENAI_API_KEY=your-openai-api-key-here
SLIP_EXTRACTION_MODEL=gpt-4o-mini

# Protected cron routes, including the external Release B produce finalizer.
# Release B does not create a scheduler; configure a durable caller separately.
CRON_SECRET=your-random-cron-secret

# P1 Daily Sales report recipients — comma/space separated LINE target IDs.
# Configured independently from the Stock report on purpose: the two reports
# must be able to go to different people. While it is unset the scheduled sales
# route logs and sends nothing, which is how delivery stays inactive until
# Production activation is approved.
SALES_SUMMARY_LINE_TARGETS=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: debug | info | warn | error  (default: debug in dev, info in prod)
LOG_LEVEL=info
